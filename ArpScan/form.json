{
    "elements": [
        {
            "type": "CheckBox",
            "name": "UseSudo",
            "caption": "arp-scan mit sudo ausführen (sudo -n, NOPASSWD erforderlich)"
        },
        {
            "type": "ValidationTextBox",
            "name": "Interface",
            "caption": "Netzwerk-Interface (leer = automatisch)"
        },
        {
            "type": "NumberSpinner",
            "name": "Timeout",
            "caption": "Timeout pro Host",
            "suffix": "ms",
            "minimum": 50,
            "maximum": 5000
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "Network",
                    "caption": "Netzwerk / IP"
                },
                {
                    "type": "NumberSpinner",
                    "name": "Bitcount",
                    "caption": "Bitcount (CIDR)",
                    "minimum": 16,
                    "maximum": 32
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Zyklischer Scan & Anwesenheit",
            "expanded": true,
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "ScanInterval",
                    "caption": "Automatischer Scan alle (0 = aus)",
                    "suffix": "Minuten",
                    "minimum": 0,
                    "maximum": 1440
                },
                {
                    "type": "NumberSpinner",
                    "name": "MissesBeforeAbsent",
                    "caption": "Abwesend nach X Scans ohne Treffer",
                    "minimum": 1,
                    "maximum": 50
                },
                {
                    "type": "List",
                    "name": "TrackedDevices",
                    "caption": "Überwachte Geräte (Anwesenheit)",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "250px",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        },
                        {
                            "caption": "MAC-Adresse (aa:bb:cc:dd:ee:ff)",
                            "name": "MAC",
                            "width": "auto",
                            "add": "",
                            "edit": {
                                "type": "ValidationTextBox"
                            }
                        }
                    ],
                    "values": []
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Erweitert (Installation von arp-scan)",
            "items": [
                {
                    "type": "ValidationTextBox",
                    "name": "ArpScanPath",
                    "caption": "Eigener Pfad zu arp-scan (leer = System oder automatisch installiert)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "AlpineMirror",
                    "caption": "Download-Mirror (Alpine Linux)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "AlpineBranch",
                    "caption": "Alpine-Version (z.B. latest-stable, v3.20)"
                },
                {
                    "type": "ValidationTextBox",
                    "name": "Architecture",
                    "caption": "Architektur (leer = automatisch: aarch64, armv7, armhf, x86_64, x86)"
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Label",
            "name": "ArpScanState",
            "caption": ""
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "arp-scan installieren / aktualisieren",
                    "onClick": "echo ARPS_InstallArpScan($id);"
                },
                {
                    "type": "Button",
                    "caption": "Hersteller-Datenbank aktualisieren",
                    "onClick": "echo ARPS_UpdateVendorDatabase($id);"
                }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                {
                    "type": "Button",
                    "caption": "Eigene IP ermitteln",
                    "onClick": "echo ARPS_GetIP($id);"
                },
                {
                    "type": "Button",
                    "caption": "Netzwerk scannen",
                    "onClick": "ARPS_ScanNetwork($id, $Network ?? '', $Bitcount ?? 0);"
                },
                {
                    "type": "Button",
                    "caption": "Gefundene Geräte in Anwesenheitsliste übernehmen",
                    "onClick": "echo ARPS_FillTrackedFromScan($id);"
                }
            ]
        },
        {
            "type": "List",
            "name": "Devices",
            "caption": "Gefundene Geräte",
            "rowCount": 15,
            "add": false,
            "delete": false,
            "columns": [
                {
                    "caption": "IP-Adresse",
                    "name": "IP",
                    "width": "150px"
                },
                {
                    "caption": "MAC-Adresse",
                    "name": "MAC",
                    "width": "170px"
                },
                {
                    "caption": "Hersteller",
                    "name": "Vendor",
                    "width": "auto"
                }
            ],
            "values": []
        }
    ],
    "status": []
}