{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "ExpansionPanel", "caption": "⚙️ Allgemein", "expanded": true,
            "items": [
                { "type": "CheckBox", "name": "Active", "caption": "Prognose aktiv" },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "IntervalHours", "caption": "Neu berechnen alle", "suffix": " h", "minimum": 1, "maximum": 24 },
                        { "type": "Select", "name": "Resolution", "caption": "Auflösung", "options": [
                            { "caption": "15 Minuten", "value": 15 }, { "caption": "30 Minuten", "value": 30 }, { "caption": "60 Minuten", "value": 60 } ] }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "RatedKw", "caption": "Elektrische Nennleistung", "suffix": " kW", "digits": 1, "minimum": 0 },
                        { "type": "NumberSpinner", "name": "LookbackDays", "caption": "Historie", "suffix": " Tage", "minimum": 30, "maximum": 1830 },
                        { "type": "NumberSpinner", "name": "Neighbors", "caption": "Vergleichstage für den Tagesverlauf", "minimum": 3, "maximum": 40 }
                    ]
                },
                {
                    "type": "Select", "name": "State", "caption": "Bundesland (Feiertage für den Tagesverlauf)",
                    "options": [
                        { "caption": "nur bundesweite Feiertage", "value": "" }, { "caption": "Baden-Württemberg", "value": "BW" }, { "caption": "Bayern", "value": "BY" },
                        { "caption": "Berlin", "value": "BE" }, { "caption": "Brandenburg", "value": "BB" }, { "caption": "Bremen", "value": "HB" },
                        { "caption": "Hamburg", "value": "HH" }, { "caption": "Hessen", "value": "HE" }, { "caption": "Mecklenburg-Vorpommern", "value": "MV" },
                        { "caption": "Niedersachsen", "value": "NI" }, { "caption": "Nordrhein-Westfalen", "value": "NW" }, { "caption": "Rheinland-Pfalz", "value": "RP" },
                        { "caption": "Saarland", "value": "SL" }, { "caption": "Sachsen", "value": "SN" }, { "caption": "Sachsen-Anhalt", "value": "ST" },
                        { "caption": "Schleswig-Holstein", "value": "SH" }, { "caption": "Thüringen", "value": "TH" }
                    ]
                },
                { "type": "Label", "caption": "Für wärmegeführte BHKW: Die Stromerzeugung folgt dem Wärmebedarf und damit der Außentemperatur. Strom- oder fahrplangeführte BHKW werden so nicht richtig vorhergesagt." }
            ]
        },
        {
            "type": "ExpansionPanel", "caption": "🔥 Erzeugung", "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "MeasVar", "caption": "Gemessene elektrische Erzeugung (archiviert)", "width": "360px" },
                        { "type": "Select", "name": "MeasType", "caption": "Messart", "options": [
                            { "caption": "Leistung (W/kW)", "value": 0 }, { "caption": "Energie je Intervall (Wh/kWh)", "value": 1 }, { "caption": "Zählerstand (Wh/kWh)", "value": 2 } ] },
                        { "type": "Select", "name": "MeasUnit", "caption": "Einheit", "options": [
                            { "caption": "automatisch (Profil)", "value": 0 }, { "caption": "W bzw. Wh", "value": 1 }, { "caption": "kW bzw. kWh", "value": 2 }, { "caption": "MW bzw. MWh", "value": 3 } ] }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "Select", "name": "EnergyInterval", "caption": "Intervall der Energiewerte", "options": [
                            { "caption": "5 Minuten", "value": 5 }, { "caption": "10 Minuten", "value": 10 }, { "caption": "15 Minuten", "value": 15 },
                            { "caption": "30 Minuten", "value": 30 }, { "caption": "60 Minuten", "value": 60 } ] },
                        { "type": "CheckBox", "name": "StampIsEnd", "caption": "Zeitstempel markiert das Intervallende" }
                    ]
                },
                { "type": "Label", "name": "InfoMeas", "caption": "" },
                {
                    "type": "List", "name": "Closures", "caption": "Stillstandstage (Wartung, Betriebsruhe – vergangene und geplante)",
                    "rowCount": 3, "add": true, "delete": true,
                    "columns": [
                        { "caption": "von", "name": "From", "width": "200px", "add": "", "edit": { "type": "SelectDate" } },
                        { "caption": "bis", "name": "To", "width": "200px", "add": "", "edit": { "type": "SelectDate" } },
                        { "caption": "Bemerkung", "name": "Note", "width": "auto", "add": "", "edit": { "type": "ValidationTextBox" } }
                    ]
                },
                { "type": "Label", "caption": "Vergangene Stillstandstage werden beim Lernen übersprungen, geplante ergeben eine Prognose von 0." }
            ]
        },
        {
            "type": "ExpansionPanel", "caption": "🌡️ Temperatur", "expanded": false,
            "items": [
                { "type": "SelectVariable", "name": "TempVar", "caption": "Außentemperatur (archiviert, °C)", "width": "400px" },
                { "type": "Label", "name": "InfoTemp", "caption": "" },
                { "type": "NumberSpinner", "name": "HeatLimit", "caption": "Heizgrenze", "suffix": " °C", "digits": 1 },
                {
                    "type": "Select", "name": "TempSource", "caption": "Temperaturvorhersage",
                    "options": [
                        { "caption": "Open-Meteo (kostenlos, braucht den Standort)", "value": 0 },
                        { "caption": "eigene Variablen mit dem Tagesmittel", "value": 1 },
                        { "caption": "keine (Mittel der Vorjahre)", "value": 2 }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "Latitude", "caption": "Breitengrad", "digits": 4, "minimum": -90, "maximum": 90 },
                        { "type": "NumberSpinner", "name": "Longitude", "caption": "Längengrad", "digits": 4, "minimum": -180, "maximum": 180 }
                    ]
                },
                { "type": "Label", "name": "InfoLocation", "caption": "" },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "TempFc0", "caption": "Tagesmittel heute" },
                        { "type": "SelectVariable", "name": "TempFc1", "caption": "Tagesmittel morgen" },
                        { "type": "SelectVariable", "name": "TempFc2", "caption": "Tagesmittel übermorgen" }
                    ]
                }
            ]
        }
    ],
    "actions": [
        { "type": "Label", "name": "InfoLast", "caption": "" },
        {
            "type": "RowLayout",
            "items": [
                { "type": "Button", "caption": "Jetzt neu berechnen", "onClick": "echo EPB_Rebuild($id);" },
                { "type": "Button", "caption": "Tagesspeicher leeren", "onClick": "echo EPB_ClearCache($id);" }
            ]
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Inaktiv" },
        { "code": 201, "icon": "error", "caption": "Messung oder Nennleistung fehlt" },
        { "code": 202, "icon": "error", "caption": "Kein Archiv gefunden" },
        { "code": 203, "icon": "error", "caption": "Messvariable fehlt oder ist nicht archiviert" },
        { "code": 205, "icon": "error", "caption": "Archivierte Außentemperatur fehlt" }
    ]
}
