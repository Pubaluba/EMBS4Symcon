{
    "$schema": "https://www.symcon.de/assets/files/validation/formSchema.json",
    "elements": [
        {
            "type": "ExpansionPanel", "caption": "⚙️ Allgemein", "expanded": true,
            "items": [
                { "type": "CheckBox", "name": "Active", "caption": "Prognose aktiv" },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "IntervalHours", "caption": "Neu berechnen alle", "suffix": " h", "minimum": 1, "maximum": 24 },
                        { "type": "Select", "name": "Resolution", "caption": "Auflösung", "options": [
                            { "caption": "15 Minuten", "value": 15 }, { "caption": "30 Minuten", "value": 30 }, { "caption": "60 Minuten", "value": 60 } ] }
                    ]
                },
                { "type": "Label", "caption": "Standort der Windanlage (Wettervorhersage):" },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "Latitude", "caption": "Breitengrad", "digits": 4, "minimum": -90, "maximum": 90 },
                        { "type": "NumberSpinner", "name": "Longitude", "caption": "Längengrad", "digits": 4, "minimum": -180, "maximum": 180 }
                    ]
                },
                { "type": "Label", "name": "InfoLocation", "caption": "" }
            ]
        },
        {
            "type": "ExpansionPanel", "caption": "🌬️ Anlage", "expanded": true,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "RatedKw", "caption": "Nennleistung", "suffix": " kW", "digits": 2, "minimum": 0 },
                        { "type": "NumberSpinner", "name": "RotorArea", "caption": "Rotorfläche", "suffix": " m²", "digits": 2, "minimum": 0 },
                        { "type": "NumberSpinner", "name": "HubHeight", "caption": "Nabenhöhe über Grund", "suffix": " m", "digits": 1, "minimum": 1, "maximum": 200 }
                    ]
                },
                { "type": "Label", "caption": "Rotorfläche: Horizontalläufer π · (Durchmesser/2)², Vertikalläufer Höhe × Durchmesser." },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "NumberSpinner", "name": "CutIn", "caption": "Einschaltgeschwindigkeit", "suffix": " m/s", "digits": 1, "minimum": 0 },
                        { "type": "NumberSpinner", "name": "CutOut", "caption": "Abschaltgeschwindigkeit", "suffix": " m/s", "digits": 1, "minimum": 1 },
                        { "type": "NumberSpinner", "name": "Cp", "caption": "Leistungsbeiwert cp", "digits": 2, "minimum": 0.05, "maximum": 0.59 }
                    ]
                },
                { "type": "Label", "caption": "cp: Anteil der Windleistung, den die Anlage nutzt (theoretisch max. 0,59; Kleinwind typisch 0,20–0,35, Vertikalläufer eher darunter). Wird nur ohne Kennlinie genutzt." },
                {
                    "type": "List", "name": "Curve", "caption": "Leistungskennlinie des Herstellers (optional, ersetzt die Formel)",
                    "rowCount": 6, "add": true, "delete": true, "sort": { "column": "Speed", "direction": "ascending" },
                    "columns": [
                        { "caption": "Wind m/s (Nabenhöhe)", "name": "Speed", "width": "200px", "add": 0, "edit": { "type": "NumberSpinner", "minimum": 0, "digits": 1 } },
                        { "caption": "Leistung kW", "name": "Power", "width": "auto", "add": 0, "edit": { "type": "NumberSpinner", "minimum": 0, "digits": 2 } }
                    ]
                },
                { "type": "Label", "name": "InfoTurbine", "caption": "" }
            ]
        },
        {
            "type": "ExpansionPanel", "caption": "🏞️ Standortumgebung", "expanded": false,
            "items": [
                { "type": "Select", "name": "Terrain", "caption": "Geländeklasse (Höhenprofil und Böigkeit)", "options": [
                    { "caption": "Wasser, Küste", "value": 0 },
                    { "caption": "offenes, flaches Gelände", "value": 1 },
                    { "caption": "Felder mit Hecken, Dorfrand", "value": 2 },
                    { "caption": "Vorstadt, lockere Bebauung", "value": 3 },
                    { "caption": "Stadt, Wald", "value": 4 } ] },
                { "type": "Select", "name": "ProfileSource", "caption": "Wind in Nabenhöhe", "options": [
                    { "caption": "aus den Modellhöhen 10/80/120/180 m (empfohlen)", "value": 0 },
                    { "caption": "nur aus 10 m mit dem Exponenten der Geländeklasse", "value": 1 } ] },
                { "type": "Label", "caption": "Niedrige Masten in der Nähe von Gebäuden und Bäumen stehen oft in verwirbelter Luft; dort weicht der echte Ertrag deutlich ab. Mit einer Messung gleicht der gelernte Faktor das teilweise aus." }
            ]
        },
        {
            "type": "ExpansionPanel", "caption": "🎯 Messung und Kalibrierung", "expanded": false,
            "items": [
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "SelectVariable", "name": "MeasVar", "caption": "Gemessene Erzeugung (archiviert, optional)", "width": "360px" },
                        { "type": "Select", "name": "MeasType", "caption": "Messart", "options": [
                            { "caption": "Leistung (W/kW)", "value": 0 }, { "caption": "Energie je Intervall (Wh/kWh)", "value": 1 }, { "caption": "Zählerstand (Wh/kWh)", "value": 2 } ] },
                        { "type": "Select", "name": "MeasUnit", "caption": "Einheit", "options": [
                            { "caption": "automatisch (Profil)", "value": 0 }, { "caption": "W bzw. Wh", "value": 1 }, { "caption": "kW bzw. kWh", "value": 2 }, { "caption": "MW bzw. MWh", "value": 3 } ] }
                    ]
                },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "Select", "name": "EnergyInterval", "caption": "Intervall der Energiewerte", "options": [
                            { "caption": "5 Minuten", "value": 5 }, { "caption": "10 Minuten", "value": 10 }, { "caption": "15 Minuten", "value": 15 },
                            { "caption": "30 Minuten", "value": 30 }, { "caption": "60 Minuten", "value": 60 } ] },
                        { "type": "CheckBox", "name": "StampIsEnd", "caption": "Zeitstempel markiert das Intervallende" }
                    ]
                },
                { "type": "Label", "name": "InfoMeas", "caption": "" },
                {
                    "type": "RowLayout",
                    "items": [
                        { "type": "CheckBox", "name": "Calibrate", "caption": "Korrekturfaktor aus der Messung lernen" },
                        { "type": "NumberSpinner", "name": "CalibDays", "caption": "Lerntage", "suffix": " Tage", "minimum": 7, "maximum": 92 }
                    ]
                },
                { "type": "Label", "caption": "Faktor = Median aus gemessener / berechneter Tagesenergie (Tage mit mindestens 0,2 Volllaststunden), begrenzt auf 0,3 bis 1,5." }
            ]
        }
    ],
    "actions": [
        { "type": "Label", "name": "InfoLast", "caption": "" },
        {
            "type": "RowLayout",
            "items": [
                { "type": "Button", "caption": "Jetzt neu berechnen", "onClick": "echo EPW_Rebuild($id);" },
                { "type": "Button", "caption": "Tagesspeicher leeren", "onClick": "echo EPW_ClearCache($id);" }
            ]
        },
        {
            "type": "RowLayout",
            "items": [
                { "type": "NumberSpinner", "name": "TestSpeed", "caption": "Wind", "suffix": " m/s", "digits": 1, "minimum": 0, "maximum": 40 },
                { "type": "Button", "caption": "Leistung bei diesem Wind anzeigen", "onClick": "echo EPW_GetPowerAt($id, (float)($TestSpeed ?? 8)) . ' kW';" }
            ]
        }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Aktiv" },
        { "code": 104, "icon": "inactive", "caption": "Inaktiv" },
        { "code": 201, "icon": "error", "caption": "Anlagendaten unvollständig" },
        { "code": 203, "icon": "error", "caption": "Messvariable fehlt oder ist nicht archiviert" },
        { "code": 204, "icon": "error", "caption": "Standort fehlt" }
    ]
}
